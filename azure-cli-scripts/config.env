# shellcheck shell=bash
# =============================================================================
#  FFA Azure CLI - shared configuration
#  Source this file before running any of the resource scripts:
#      source ./config.env
#  Naming convention: {type}-{app}-{env}-{region}-{inst}
# =============================================================================

# --- Identity / scope --------------------------------------------------------
export SUBSCRIPTION_ID="${SUBSCRIPTION_ID:-2194708d-e52f-4781-afb9-90430ce54a64}"
export TENANT_ID="${TENANT_ID:-}"

# --- Common ------------------------------------------------------------------
export RG="${RG:-rg-flintfox-prod-wus2-01}"
export LOCATION="${LOCATION:-westus2}"
export TAGS="${TAGS:-app=flintfox env=prod owner=devex}"

# --- VM ---------------------------------------------------------------------
export VM_NAME="${VM_NAME:-vm-flintfox-prod-wus2-01}"
export VM_COMPUTER_NAME="${VM_COMPUTER_NAME:-ffa-wus2-01}"   # Windows hostname (<=15 chars, alphanumeric + hyphen, not all numeric)
export VM_SIZE="${VM_SIZE:-}"   # empty -> 07-create-vm.sh prompts; set explicitly to skip prompt
export VM_IMAGE="${VM_IMAGE:-MicrosoftWindowsServer:WindowsServer:2025-datacenter:latest}"
export VM_OS_DISK_NAME="${VM_OS_DISK_NAME:-${VM_NAME}-osdisk}"
export VM_OS_DISK_SIZE_GB="${VM_OS_DISK_SIZE_GB:-256}"
export VM_OS_DISK_SKU="${VM_OS_DISK_SKU:-Premium_LRS}"
export VM_ADMIN_USERNAME="${VM_ADMIN_USERNAME:-azureadmin}"
# If VM_ADMIN_PASSWORD is empty, 07-create-vm.sh will prompt for it interactively.
# In a pipeline, source it from Key Vault before running:
#   export VM_ADMIN_PASSWORD="$(az keyvault secret show --vault-name kv-flintfox-prod-wus2-01 \
#                              --name vm-admin-password --query value -o tsv)"
export VM_ADMIN_PASSWORD="${VM_ADMIN_PASSWORD:-}"

# --- Network ----------------------------------------------------------------
# VNET name kept under 15 chars
export VNET_NAME="${VNET_NAME:-vnet-ffa-wus2}"
export VNET_PREFIX="${VNET_PREFIX:-10.0.0.0/16}"
export SUBNET_NAME="${SUBNET_NAME:-snet-flintfox-prod-wus2-01}"
export SUBNET_PREFIX="${SUBNET_PREFIX:-10.0.1.0/24}"
export NSG_NAME="${NSG_NAME:-nsg-flintfox-prod-wus2-01}"
export PIP_NAME="${PIP_NAME:-${VM_NAME}-pip}"
export NIC_NAME="${NIC_NAME:-${VM_NAME}-nic}"

# --- FFA app ports (sourced from PS1 Script 01 + 04) -------------------------
export FFA_APP_PORTS="444 446 5001 5002 8005 8006 9000 9001"
export RDP_ALLOWED_CIDR="${RDP_ALLOWED_CIDR:-10.0.0.0/8}"

# --- Azure SQL (optional - 10-create-sql-server.sh) -------------------------
export SQL_SERVER_NAME="${SQL_SERVER_NAME:-ffa-sql-test-01}"
export SQL_ADMIN_USER="${SQL_ADMIN_USER:-sqladmin}"
# Provide via Key Vault or env. If empty, 10-create-sql-server.sh will prompt.
export SQL_ADMIN_PASSWORD="${SQL_ADMIN_PASSWORD:-}"
# DB SKU. Common options: Basic, S0 (Standard, 10 DTU), GP_S_Gen5_2 (serverless).
export SQL_DB_SKU="${SQL_DB_SKU:-S0}"
# Space-separated list of database names to create.
export SQL_DBS="${SQL_DBS:-RMx_Config RMx_SampleTenant}"
